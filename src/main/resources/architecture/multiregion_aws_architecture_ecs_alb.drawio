<mxfile host="Electron">
  <diagram name="AWS VPC Single-Region Architecture" id="aws-vpc-architecture">
    <mxGraphModel dx="1334" dy="890" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Outer AWS Cloud -->
        <mxCell id="cloud" parent="1" style="shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;html=1;fontSize=14;fontStyle=1;" value="AWS Cloud" vertex="1">
          <mxGeometry height="770" width="1210" x="20" y="20" as="geometry" />
        </mxCell>

        <!-- Single Region: Asia Pacific (Mumbai) -->
        <mxCell id="region" parent="1" style="shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_region;strokeColor=#00A4A6;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#147EBA;dashed=1;html=1;fontSize=13;fontStyle=1;" value="Asia Pacific (Mumbai) - ap-south-1" vertex="1">
          <mxGeometry height="705" width="1150" x="50" y="70" as="geometry" />
        </mxCell>

        <!-- Internet Gateway (Direct entry point - No Route 53) -->
        <mxCell id="igw" parent="1" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=1;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.internet_gateway;" value="Internet gateway&#xa;(Direct entry to ALB - No Route 53)" vertex="1">
          <mxGeometry height="50" width="50" x="600" y="90" as="geometry" />
        </mxCell>

        <!-- VPC Container -->
        <mxCell id="vpc" parent="1" style="shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_vpc2;strokeColor=#8C4FFF;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;html=1;fontSize=13;fontStyle=1;" value="Virtual private cloud (VPC) - vpc-0a51a2e95f117ecfd (172.31.0.0/16)" vertex="1">
          <mxGeometry height="580" width="1090" x="80" y="180" as="geometry" />
        </mxCell>

        <!-- Availability Zones -->
        <mxCell id="az1a" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#00A4A6;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=10;fontColor=#00A4A6;fontSize=13;fontStyle=1;" value="ap-south-1a (Active Workloads)" vertex="1">
          <mxGeometry height="525" width="370" x="110" y="220" as="geometry" />
        </mxCell>

        <mxCell id="az1b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#00A4A6;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=10;fontColor=#00A4A6;fontSize=13;fontStyle=1;" value="ap-south-1b (ALB Required Second AZ)" vertex="1">
          <mxGeometry height="525" width="370" x="770" y="220" as="geometry" />
        </mxCell>

        <!-- 3 Horizontal Security Group Tiers -->
        <mxCell id="sgweb" parent="1" style="rounded=0;html=1;fillColor=none;strokeColor=#DD6B10;dashed=1;dashPattern=8 4;strokeWidth=1.5;" value="" vertex="1">
          <mxGeometry height="145" width="1050" x="100" y="245" as="geometry" />
